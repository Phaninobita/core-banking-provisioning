# Server Port
PORT=3000

# Environment: 'development' or 'production'
NODE_ENV=development

# PostgreSQL / Supabase Database Connection String
# Example: postgresql://postgres:your-password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# JWT Secret Key for Session Token Signing
JWT_SECRET=super-secret-gringotts-bank-jwt-key-change-in-production

# Google Cloud Vision API Key (Optional - for OCR text detection)
# If left empty, a smart built-in MRZ/license parser will be used as fallback
GOOGLE_VISION_API_KEY=
